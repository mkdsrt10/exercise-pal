# Copy to .env and fill in. Never commit .env.

# ── Post-set review ─────────────────────────────────────────────
# Pick one. COACH_PROVIDER=auto uses the first that is set up:
#   anthropic: ANTHROPIC_API_KEY, or no key at all after `ant auth login`
#   bedrock:   your AWS credentials (AWS_PROFILE or keys) + BEDROCK_REGION
#   gemini:    GEMINI_API_KEY only (the same key also runs the decision scoring)
COACH_PROVIDER=auto

ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5

BEDROCK_REGION=
AWS_PROFILE=
BEDROCK_MODEL=anthropic.claude-opus-5-5

GEMINI_COACH_MODEL=gemini-3.8-flash

# ── Calibrated decisions (exercise / equipment / form scoring) ──
GEMINI_API_KEY=

# Object storage: any S3-compatible service (MinIO by default)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=exercise-pal
S3_ACCESS_KEY=exercisepal
S3_SECRET_KEY=change-me-please
S3_FORCE_PATH_STYLE=true

# MinIO root credentials used by docker-compose (match the S3_* keys above)
MINIO_ROOT_USER=exercisepal
MINIO_ROOT_PASSWORD=change-me-please

# Auto-log a decision without asking when confidence >= this value
AUTO_ACCEPT_CONFIDENCE=0.85
